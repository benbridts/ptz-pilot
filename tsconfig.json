{
	"compilerOptions": {
		"target": "ES2023",
		"module": "Node16",
		"moduleResolution": "Node16",
		"lib": ["ES2023"],
		"types": ["node"],
		"strict": true,
		"noUnusedLocals": true,
		"skipLibCheck": true,
		"sourceMap": true,
		"rootDir": ".",
		"outDir": "dist"
	},
	"include": ["src/main/**/*.ts", "src/preload/**/*.ts", "test/**/*.ts"]
}
